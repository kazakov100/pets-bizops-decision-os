{
  "result": {
    "framework_id": "three_horizons",
    "rag_source": "McKinsey & Company, \"Enduring Ideas: The three horizons of growth\" -- https://www.mckinsey.com/capabilities/strategy-and-corporate-finance/our-insights/enduring-ideas-the-three-horizons-of-growth",
    "bottom_line": "Pet has crossed into Horizon-1 scale (largest line as of early Q2'26, $490M IFP) but still carries Horizon-2 underwriting volatility -- the risk/opportunity map hinges on whether its 68-72% loss ratio can stabilize as it becomes the core engine.",
    "narrative": "Pet's in-force premium more than doubled from $201M (Q1'24) to $490M (Q1'26) and now rivals Homeowners ($540M) for largest segment, while its gross loss ratio has stayed range-bound between 63% and 72% across nine quarters rather than trending down with scale. Meanwhile Homeowners (the historical core) shows a sharply improving margin picture (39% company-wide gross profit margin, Adjusted EBITDA improving from -$33.9M to -$17.1M) that can fund continued investment in Horizon-2/3 bets like Pet, Car, and Europe, even as Annual Dollar Retention has slipped from 88% to 85%.",
    "executive_summary": {
      "key_takeaway": "Pet is now Lemonade's de facto core business by size but still behaves like a Horizon-2 asset on loss ratio, so it needs Horizon-1-grade underwriting discipline, not just growth capital.",
      "why_it_matters": "Pet is now the largest line but margin discipline hasn't caught up",
      "recommended_action": "Prioritize tightening Pet's pricing/underwriting cadence (rate filings, claims triage) to convert its scale into a durable loss-ratio improvement before treating it as a stabilized Horizon-1 cash generator.",
      "kpi_impact": {
        "metric_label": "Pet gross loss ratio",
        "dollar_estimate": {
          "applies": true,
          "base_metric": "pet_ifp_m",
          "low_points": 1,
          "base_points": 2,
          "high_points": 3,
          "assumption_rationale": "Pet's gross loss ratio has ranged 63-72% over 9 disclosed quarters (get_pet_loss_ratio_trend), so a conservative 1-3 point underwriting improvement sits within its own observed historical band."
        }
      }
    },
    "items": [
      {
        "title": "Pet loss ratio plateau at scale",
        "type": "risk",
        "framework_element": "Horizon 2 -- Pet",
        "impact": "high",
        "confidence": "high",
        "detail": "Pet IFP grew from $201M to $490M (Q1'24-Q1'26) yet gross loss ratio stayed range-bound 63-72% with no clear downward trend; scale hasn't yet translated into underwriting leverage, risking margin drag as Pet becomes the largest line.",
        "evidence_source": "get_pet_loss_ratio_trend"
      },
      {
        "title": "Homeowners core volatility",
        "type": "risk",
        "framework_element": "Horizon 1 -- Homeowners",
        "impact": "high",
        "confidence": "medium",
        "detail": "Homeowners loss ratio swung from 82% (Q1'25) to 49% (Q1'26) quarter to quarter; this instability in the core cash-generating segment could disrupt the funding base Horizon-2/3 bets like Pet and Europe rely on.",
        "evidence_source": "get_all_segments_trend"
      },
      {
        "title": "Car underwriting inconsistency",
        "type": "risk",
        "framework_element": "Horizon 2 -- Car",
        "impact": "medium",
        "confidence": "medium",
        "detail": "Car's gross loss ratio has swung from 99% (Q1'24) to 40% (Q4'25) back to 74% (Q1'26), showing it has not yet earned durable Horizon-2 status; continued volatility could crowd out capital better spent scaling Pet.",
        "evidence_source": "get_all_segments_trend"
      },
      {
        "title": "Pet cross-sell flywheel",
        "type": "opportunity",
        "framework_element": "Horizon 2 -- Pet",
        "impact": "high",
        "confidence": "high",
        "detail": "Pet IFP grew 56% YoY and became Lemonade's largest product line as of early Q2'26, with $85M of that IFP sourced from existing-customer cross-sell -- a Horizon-1 customer base is directly fueling Horizon-2 scale, a compounding growth lever.",
        "evidence_source": "get_pet_segment_kpis"
      },
      {
        "title": "Europe early-stage optionality",
        "type": "opportunity",
        "framework_element": "Horizon 3 -- Europe",
        "impact": "medium",
        "confidence": "medium",
        "detail": "Europe is still Lemonade's smallest segment ($67M IFP) but its loss ratio improved from 106% (Q1'24) to 85% (Q1'26) while IFP grew steadily each quarter, suggesting a genuine early-stage option worth continued seeding rather than harvesting.",
        "evidence_source": "get_all_segments_trend"
      },
      {
        "title": "Core margin funds future horizons",
        "type": "opportunity",
        "framework_element": "Horizon 1 -- Company core",
        "impact": "high",
